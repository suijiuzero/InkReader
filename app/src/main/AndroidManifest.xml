<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Android 11（API 30）起有「软件包可见性」限制：不声明这条 queries，
      App 根本看不到系统的 TTS 引擎，TextToSpeech 初始化会直接失败，
      表现出来就是「朗读点了没反应」。官方文档明确要求声明这个 intent action。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 导出 TXT 到公共下载目录：API 29 起改用 MediaStore，不再需要此权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      largeHeap：pdfbox 解析大 PDF 时临时堆占用较高，保留大堆以降低 OOM 概率；
      导入侧已加 200MB 单文件上限，两者配合避免极端输入打爆内存。
    -->
    <application
        android:name=".InkApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InkReader"
        tools:targetApi="34">

        <!--
          launchMode 用 singleTask —— 与同机可用的 SJopi 保持一致（它的注释是「单 Activity 应用必须这么设」）。
          之前的 singleTop 改动基于「singleTask 会被国产 ROM 判成 RESULT_CANCELED」的推测，
          但实测对照推翻了它：SJopi 就是 singleTask，用它打开 vivo 文件管理器一直正常；
          而墨阅改成 singleTop 后，落盘留痕显示选择器发起成功、5.005 秒后却收到
          `res=0 uris=0 data=false`（系统侧自动取消）。所以按能用的那套来。
          singleTask 还能保证「用其他应用打开 / 分享」进来时复用同一实例，不会出现两个 MainActivity。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection|colorMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.InkReader"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            </intent-filter>
            <!-- Markdown / PDF / HTML / EPUB：用其他应用「打开方式」时能选到墨阅 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="text/x-markdown" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
                <data android:scheme="content" android:mimeType="text/html" />
                <data android:scheme="content" android:mimeType="application/xhtml+xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".tts.TtsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 导出 TXT 的分享通道：把 cacheDir/exports/ 下的文件暴露成 content:// URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
