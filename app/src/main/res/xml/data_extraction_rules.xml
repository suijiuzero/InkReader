        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="chapters/" />
        <include domain="file" path="covers/" />
        <include domain="file" path="recognition-notes/" />
    </device-transfer>
</data-extraction-rules>
